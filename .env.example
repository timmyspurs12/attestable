# ---- Attestable :: environment ----
# cp .env.example .env   (NEVER commit .env — it is gitignored)

# Wallet. Use a THROWAWAY key for the hackathon. Never a key that has held real funds.
PRIVATE_KEY=
WALLET_PASSWORD=
DEPLOYER_ADDRESS=

# Network
NETWORK=bsc-testnet
RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# BscScan — REQUIRED for contract verification (an explicit scoring criterion)
# Free key: https://bscscan.com/myapikey
ETHERSCAN_API_KEY=

# Sponsor integrations (fill in as you wire each one)
APRO_API_KEY=
NETMIND_API_KEY=
UNIBASE_API_KEY=

# Live APEX (ERC-8183) stack — BSC testnet.
# Source of truth: github.com/bnb-chain/apex-contracts#deployments
ERC8183_COMMERCE_ADDRESS=0xa206c0517B6371C6638CD9e4a42Cc9f02A33B0DE
ERC8183_ROUTER_ADDRESS=0xd7d36d66d2f1b608a0f943f722d27e3744f66f25
ERC8183_POLICY_ADDRESS=0x4f4678d4439fec812ac7674bb3efb4c8f5fb78a6
PAYMENT_TOKEN=0xc70B8741B8B07A6d61E54fd4B20f22Fa648E5565
